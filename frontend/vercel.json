{
  "installCommand": "npm install --include=dev",
  "buildCommand": "NODE_OPTIONS=--max-old-space-size=6144 npm run build:prod",
  "outputDirectory": "dist/hhc-laser-frontend/browser",
  "framework": null,
  "redirects": [
    {
      "source": "/services/book-this-service",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/services/Book-This-Service",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/services/book_this_service",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/book-this-service",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/book-now",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/book",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/booking",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/create-account",
      "destination": "/auth/register",
      "permanent": true
    },
    {
      "source": "/create-an-account",
      "destination": "/auth/register",
      "permanent": true
    },
    {
      "source": "/Create-An-Account",
      "destination": "/auth/register",
      "permanent": true
    },
    {
      "source": "/create_account",
      "destination": "/auth/register",
      "permanent": true
    },
    {
      "source": "/signup",
      "destination": "/auth/register",
      "permanent": true
    },
    {
      "source": "/sign-up",
      "destination": "/auth/register",
      "permanent": true
    },
    {
      "source": "/register",
      "destination": "/auth/register",
      "permanent": true
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
