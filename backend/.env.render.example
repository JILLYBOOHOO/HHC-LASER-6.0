# Render API deploy — copy these into the Render dashboard Environment tab.
# Do NOT commit real secrets. Values marked COPY FROM LOCAL come from backend/.env.

NODE_ENV=production
PORT=10000

# Temporary pre-DNS testing (Vercel + Render default hosts):
# API_BASE_URL=https://hhc-laser-api.onrender.com
# FRONTEND_URL=https://hhc-laser-6-0.vercel.app
# ALLOWED_ORIGINS=https://hhc-laser-6-0.vercel.app,https://hhclaser.com,https://www.hhclaser.com
# FISERV_SUCCESS_URL=https://hhc-laser-api.onrender.com/api/payments/success
# FISERV_FAILURE_URL=https://hhc-laser-api.onrender.com/api/payments/error
# FISERV_CALLBACK_URL=https://hhc-laser-api.onrender.com/api/payments/callback

# After GoDaddy DNS cutover, use the custom domains below:
API_BASE_URL=https://api.hhclaser.com
FRONTEND_URL=https://hhclaser.com
ALLOWED_ORIGINS=https://hhclaser.com,https://www.hhclaser.com

# COPY FROM LOCAL (Supabase)
DATABASE_URL=
DB_SSL=true
DB_CONNECTION_LIMIT=20
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# GENERATE NEW for production (do not reuse REPLACE_ placeholders)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# COPY FROM LOCAL (Fiserv LIVE)
FISERV_MERCHANT_ID=
FISERV_STORE_ID=
FISERV_STORE_NAME=
FISERV_SHARED_SECRET=
FISERV_API_KEY=
FISERV_CURRENCY=388
FISERV_BASE_URL=https://www2.ipg-online.com
FISERV_GATEWAY_URL=https://www2.ipg-online.com/connect/gateway/processing
FISERV_SUCCESS_URL=https://api.hhclaser.com/api/payments/success
FISERV_FAILURE_URL=https://api.hhclaser.com/api/payments/error
FISERV_CALLBACK_URL=https://api.hhclaser.com/api/payments/callback

# Optional
RESEND_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_ENABLE_PRODUCTION_DOMAIN=true
