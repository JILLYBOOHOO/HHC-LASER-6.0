# HHC LASER Backend Environment Variables
# Copy this file to .env and fill in real values. NEVER commit .env to git.

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_SECRET
JWT_REFRESH_EXPIRES_IN=7d

# ─── Supabase Postgres ────────────────────────────────────────────────────────
# Dashboard → Connect → Transaction pooler URI
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres
DB_CONNECTION_LIMIT=20
DB_SSL=true

# ─── Supabase Auth (Dashboard → Project Settings → API) ───────────────────────
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_SECRET_KEY
SUPABASE_JWT_SECRET=YOUR_JWT_SECRET

# ─── Supabase Storage (Phase 3) ───────────────────────────────────────────────
# Buckets hhc-public + hhc-private are auto-created on API startup when service role is set.
# Dashboard → Storage to verify. Public URLs use hhc-public; consent PDFs use hhc-private.

# ─── AWS S3 (optional fallback if Supabase Storage is not configured) ─────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=REPLACE_WITH_IAM_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_IAM_SECRET
S3_BUCKET_NAME=hhc-laser-media
S3_BUCKET_URL=https://hhc-laser-media.s3.amazonaws.com

# ─── AWS SES (Email) ──────────────────────────────────────────────────────────
SES_FROM_EMAIL=noreply@hhclaser.com
SES_REPLY_TO=info@hhclaser.com

# ─── Scotiabank Fiserv Payment Gateway ────────────────────────────────────────
FISERV_MERCHANT_ID=REPLACE_WITH_MERCHANT_ID
FISERV_API_KEY=REPLACE_WITH_API_KEY
FISERV_SHARED_SECRET=REPLACE_WITH_SHARED_SECRET
FISERV_STORE_NAME=REPLACE_WITH_STORE_NAME
FISERV_STORE_ID=REPLACE_WITH_STORE_ID
FISERV_CURRENCY=388
FISERV_BASE_URL=https://test.ipg-online.com
FISERV_GATEWAY_URL=https://test.ipg-online.com/connect/gateway/processing
FISERV_CALLBACK_URL=https://api.hhclaser.com/api/payments/callback
# Fiserv browser returns are POSTs — must hit the API, not the Angular SPA
FISERV_SUCCESS_URL=https://api.hhclaser.com/api/payments/success
FISERV_FAILURE_URL=https://api.hhclaser.com/api/payments/error

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:4200,https://hhclaser.com,https://www.hhclaser.com

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ─── Frontend URL ─────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:4200

